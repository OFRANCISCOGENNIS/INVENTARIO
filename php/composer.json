{
    "name": "inventario/analise-inventario",
    "description": "Analise de inventario SAP x PRJ (porta PHP do modulo VBA inventario.bas)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Inventario\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inventario\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/inventario"],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
